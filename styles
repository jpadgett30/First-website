header {
    position:fixed;
    text-align: center;
    height: 120px;
    
    background-color: rgb(28, 0, 114);
}

header h1 {
    position: relative;
    text-align: center;
    left: -100px;
}

.top-nav {
    position: absolute;
    text-align: center;
    background-color: silver;
    width: 100vw;
    top:120px;
}

header > nav a, header > nav a:visited {
    width: 20px;
    background-color: silver;
    margin-right: 20px;
    margin-left: 20px;
    font-size: 25px;
    
}

header > nav a, header > nav a:visited {
    text-decoration: none;
    color: inherit;
}

.top-nav a:hover {
    background-color: gray;
    color:azure
}

main {
    height: 200vw;
    text-align: center;
    background-color: green;
}

aside {
    
    text-align: center;
    background-color: yellow;
}

footer {
    
    text-align: center;
    background-color: orange;
}
